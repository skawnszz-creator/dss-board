# ------------------------------------------------------------------
# DSS 사내 게시판 — 환경변수 예시
#
# 이 파일을 복사해서 .env.local 을 만들고 실제 값을 채운다.
# .env.local 은 git 에 올리지 않는다. 비밀번호를 여기에 적지 않는다.
# ------------------------------------------------------------------

# 이 사이트 전용 PostgreSQL DB (계측기·휴가 DB 와 따로)
DATABASE_URL=postgres://dss_board:여기에_비밀번호@localhost:5432/dss_board

# 이 사이트가 쓸 포트
# A/S 3000 · 포털(dss-auth) 3100 · 홈페이지 3200 · 계측기 3300 ·
# 게시판 3400 · 개선요청 3500 · PO 3600 · 휴가 3700 · 재고 3800
PORT=3400

# 사진·첨부파일을 쌓아두는 폴더 (절대경로).
# DB 에는 이 아래의 상대경로만 저장한다. NAS 에서는 볼륨으로 붙인 /data 를 쓴다.
STORAGE_ROOT=C:\WEB-DATA\dss-board

# 세션 쿠키에 secure 를 붙일지.
# 사내망 HTTP 단계에서 true 로 켜면 쿠키가 저장되지 않아 로그인이 조용히 실패한다.
# HTTPS 를 붙인 뒤에 true 로 바꾼다.
SESSION_COOKIE_SECURE=false

# 세션 수명(시간). dss-auth SSO 세션의 절대 만료 12시간을 넘기지 않는다.
SESSION_HOURS=12

# ------------------------------------------------------------------
# 임시 로그인 — dss-auth OIDC 연결 시 폐기 대상
# 기본값은 반드시 꺼짐(false). 개발 중에만 true 로 둔다.
# ------------------------------------------------------------------
DEV_FAKE_LOGIN_ENABLED=false

# ------------------------------------------------------------------
# dss-auth 통합 로그인 (표준 OIDC)
# client_secret 에 NEXT_PUBLIC_ 접두사를 붙이지 않는다 — 브라우저로 새어나간다.
#
# auto 가 무엇을 하나: 서버가 뜰 때 이 기계의 사내망 IPv4 를 직접 찾아
#   OIDC_ISSUER       → http://<이 기계 주소>:3100
#   OIDC_REDIRECT_URI → http://<이 기계 주소>:3400/api/auth/callback
# 로 푼다. 개발 PC 도 NAS 도 주소를 DHCP 로 받으므로, Wi-Fi 가 바뀌어도
# 여기를 고칠 필요가 없다. 요청에서 만들어 쓰는 것과 달리 누가 부르든 같은
# 문자열이 나온다(src/lib/lan-address.ts).
# 포털도 같은 방식으로 자기 주소를 찾으므로 두 값이 어긋나지 않는다.
#
# 언제 직접 적어야 하나:
#   - 운영(HTTPS 도메인) — 앞에 리버스 프록시가 서면 밖에서 보이는 이름이
#     IP 가 아니라 도메인이라 이 기계가 알아낼 수 없다. auto 는 언제나 http 다.
#       OIDC_ISSUER=https://auth.dss21.co.kr
#       OIDC_REDIRECT_URI=https://board.dss21.co.kr/api/auth/callback
#   - 포털이 다른 기계에 있을 때
#   - 포트만 다를 때는 auto:3100 처럼 적어도 된다
# 직접 적은 값은 포털에 등록된 값과 문자 단위로 같아야 한다.
# ------------------------------------------------------------------
OIDC_ISSUER=auto
OIDC_CLIENT_ID=dss-board
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=auto

# code_verifier·state·nonce 를 담는 10분 쿠키의 서명 열쇠.
# 아무 긴 임의 문자열. 다음 명령으로 만든다:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_STATE_SECRET=
